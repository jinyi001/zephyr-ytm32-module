config SOC_SERIES_YTM32B1M
	bool
	select SOC_FAMILY_YTMICRO_YTM32
	select ARM
	select CPU_CORTEX_M
	select CPU_CORTEX_M33
	select CPU_HAS_ARM_MPU
	select INIT_ARCH_HW_AT_BOOT
	select HAS_SEGGER_RTT if ZEPHYR_SEGGER_MODULE

config SOC_SERIES
	default "ytm32b1m" if SOC_SERIES_YTM32B1M

config SOC_YTM32B1MC0
	bool "YTM32B1MC0 MCU"
	select SOC_SERIES_YTM32B1M
	select SOC_PART_NUMBER_YTM32B1MC03H0MLHT

config SOC_YTM32B1MD1
	bool "YTM32B1MD1 MCU"
	select SOC_SERIES_YTM32B1M
	select SOC_PART_NUMBER_YTM32B1MD1
	select CPU_HAS_FPU
	select ARMV8_M_DSP

config SOC
	default "ytm32b1mc0" if SOC_YTM32B1MC0
	default "ytm32b1md1" if SOC_YTM32B1MD1

config SOC_PART_NUMBER_YTM32B1MC03H0MLHT
	bool

config SOC_PART_NUMBER_YTM32B1MD1
	bool

config SOC_PART_NUMBER
	default "YTM32B1MC03H0MLHT" if SOC_PART_NUMBER_YTM32B1MC03H0MLHT
	default "YTM32B1MD1" if SOC_PART_NUMBER_YTM32B1MD1
