if SOC_SERIES_YTM32B1M

config NUM_IRQS
	default 76 if SOC_YTM32B1MC0
	default 192 if SOC_YTM32B1MD1

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 80000000 

config CORTEX_M_SYSTICK
	default y

# soc_reset_hook runs before VTOR is redirected, disabling SysTick to prevent
# the bootloader's timer from firing through our sys_clock_isr before kernel
# data (.data section) is initialised.  It also writes all SRAM to clear ECC.
config SOC_RESET_HOOK
	default y

# Run SystemInit() to disable watchdog and configure flash.
config SOC_EARLY_INIT_HOOK
	default y

endif # SOC_SERIES_YTM32B1M