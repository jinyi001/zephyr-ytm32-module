config DMA_YTM32
	bool "YTM32 DMA controller driver"
	default y
	depends on DT_HAS_YTMICRO_YTM32_DMA_ENABLED
	select DMA
	help
	  Enable DMA driver for YTM32 series. Provides the Zephyr DMA API
	  and connects all per-channel IRQ handlers required by peripherals
	  (SPI, UART, I2C) that use DMA mode through the vendor HAL.

config DMA_YTM32_CH8_ZERO_LATENCY
	bool "Connect DMA channel 8 as a zero-latency direct IRQ"
	depends on DMA_YTM32 && ZERO_LATENCY_IRQS
	help
	  Connect DMA8_IRQn with IRQ_DIRECT_CONNECT and IRQ_ZERO_LATENCY for the
	  ADC DMA motor-control path. Other DMA channels remain normal Zephyr IRQs.

config DMA_YTM32_CH8_ZLI_TIMING
	bool "Instrument DMA channel 8 zero-latency interrupt timing"
	depends on DMA_YTM32_CH8_ZERO_LATENCY
	help
	  Use DWT->CYCCNT to timestamp the ADC DMA channel 8 zero-latency
	  interrupt path. Intended for trigger_chain timing validation only.
	  Requires CMSIS DWT/CoreDebug headers (provided by the vendor HAL).
